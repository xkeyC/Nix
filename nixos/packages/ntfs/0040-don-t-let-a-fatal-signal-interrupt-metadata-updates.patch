Subject: [PATCH] ntfs: don't let a fatal signal interrupt metadata reads

read_mapping_folio() waits for the read it submits with
folio_wait_locked_killable(), so it returns -EINTR as soon as the caller
has a fatal signal pending. A metadata read that fails like that in the
middle of an update (unlink(), a directory index update, a cluster or MFT
record allocation) stops the update half way, leaving clusters allocated
in $Bitmap, an MFT record in use or a directory index inconsistent; even
a failed lookup ends in ntfs_error(), so errors=remount-ro turns the
volume read-only.

Add ntfs_read_metadata_folio() in aops.c, which reads the folio the same
way but waits for the read uninterruptibly and checks the result with the
folio locked, and use it for metadata reads: $Bitmap and $MFT/$BITMAP
updates and scans, MFT records, $MFTMirr, attribute reads and writes
(directory index blocks), directory lookups, ntfs_attr_set() and the
block device read-modify-write that empties $LogFile. Mount-time checks
and compressed file data keep using read_mapping_folio().

Not upstream: local patch against v7.3.1, prepared for ntfs-next in
github.com/xkeyC/linux-ntfs branch fix-eintr-metadata-update. It also
covers the lookup case of namjaejeon/linux-ntfs#98 that 0039 works around.
Testing is described in README.md.
---
diff --git a/fs/ntfs/aops.c b/fs/ntfs/aops.c
index 517d9a1..601c6ea 100644
--- a/fs/ntfs/aops.c
+++ b/fs/ntfs/aops.c
@@ -7,6 +7,7 @@
  * Copyright (c) 2025 LG Electronics Co., Ltd.
  */
 
+#include <linux/swap.h>
 #include <linux/writeback.h>
 
 #include "attrib.h"
@@ -303,6 +304,71 @@ static int ntfs_swap_activate(struct swap_info_struct *sis,
 			&ntfs_read_iomap_ops);
 }
 
+/**
+ * ntfs_read_metadata_folio - read a metadata folio without being interrupted
+ * @mapping:	address space of the metadata inode or block device
+ * @index:	page cache index to read
+ *
+ * read_mapping_folio() waits for the read it submits with
+ * folio_wait_locked_killable(), so it fails with -EINTR as soon as the
+ * caller has a fatal signal pending.  A metadata read that fails like that
+ * in the middle of an update (an unlink(), a directory index update, a
+ * cluster or MFT record allocation) stops the update half way, and even a
+ * failed lookup ends in ntfs_error(), which applies errors=remount-ro.
+ *
+ * Read the folio the same way, but wait for the read uninterruptibly, as
+ * the buffer cache does for metadata of other filesystems.  The uptodate
+ * check is made with the folio locked, because ntfs clears and sets the
+ * uptodate flag of $MFT folios under the folio lock while it updates them.
+ *
+ * Return: the uptodate folio with a reference held, or an ERR_PTR(): -EIO
+ * if the read failed, or the error from allocating or reading the folio.
+ */
+struct folio *ntfs_read_metadata_folio(struct address_space *mapping,
+				       pgoff_t index)
+{
+	struct folio *folio;
+	bool read_failed = false;
+	int err;
+
+	folio = filemap_get_folio(mapping, index);
+	if (!IS_ERR(folio)) {
+		if (folio_test_uptodate(folio))
+			goto out;
+		folio_put(folio);
+	}
+repeat:
+	folio = __filemap_get_folio(mapping, index, FGP_LOCK | FGP_CREAT,
+				    mapping_gfp_mask(mapping));
+	if (IS_ERR(folio))
+		return folio;
+	if (folio_test_uptodate(folio)) {
+		folio_unlock(folio);
+		goto out;
+	}
+	if (read_failed) {
+		folio_unlock(folio);
+		folio_put(folio);
+		return ERR_PTR(-EIO);
+	}
+
+	/* ->read_folio() unlocks the folio when the read completes. */
+	err = mapping->a_ops->read_folio(NULL, folio);
+	if (err) {
+		folio_put(folio);
+		if (err == AOP_TRUNCATED_PAGE)
+			goto repeat;
+		return ERR_PTR(err);
+	}
+	folio_wait_locked(folio);
+	read_failed = !folio_test_uptodate(folio);
+	folio_put(folio);
+	goto repeat;
+out:
+	folio_mark_accessed(folio);
+	return folio;
+}
+
 const struct address_space_operations ntfs_aops = {
 	.read_folio		= ntfs_read_folio,
 	.readahead		= ntfs_readahead,
