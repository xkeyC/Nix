diff --git a/fs/ntfs/ntfs.h b/fs/ntfs/ntfs.h
index cb69707..2c07fa6 100644
--- a/fs/ntfs/ntfs.h
+++ b/fs/ntfs/ntfs.h
@@ -290,6 +290,52 @@ static inline int ntfs_ffs(int x)
 	return r;
 }
 
+/**
+ * ntfs_read_metadata_folio - read a metadata folio without being interrupted
+ * @mapping:	address space of the metadata inode
+ * @index:	page cache index to read
+ *
+ * read_mapping_folio() waits for its own read with folio_wait_locked_killable(),
+ * so it returns -EINTR when the caller has a fatal signal pending.  On paths
+ * that update metadata that error is never wanted: a signal that arrives in
+ * the middle of an unlink(), a directory index update or a cluster or MFT
+ * record allocation would stop the update half way, leaving clusters or MFT
+ * records allocated, an index or $MFTMirr inconsistent, and errors=remount-ro
+ * turns the volume read-only.  Use this helper for every metadata read that can
+ * happen on such a path.  Lookups and mount-time reads, which change nothing
+ * yet, may keep using read_mapping_folio().
+ *
+ * The read has already been submitted when the killable wait gives up, so
+ * wait for it with an uninterruptible lock wait instead.  This only waits for
+ * I/O that is already in flight.  If the folio is reclaimed before it can be
+ * looked up again, retry the read a few times before giving up.
+ *
+ * Return: the uptodate folio with a reference held, or an ERR_PTR().
+ */
+static inline struct folio *ntfs_read_metadata_folio(struct address_space *mapping,
+						     pgoff_t index)
+{
+	struct folio *folio;
+	int tries = 3;
+
+	do {
+		folio = read_mapping_folio(mapping, index, NULL);
+		if (PTR_ERR_OR_ZERO(folio) != -EINTR)
+			return folio;
+
+		folio = filemap_get_folio(mapping, index);
+		if (IS_ERR(folio))
+			continue;
+		folio_wait_locked(folio);
+		if (folio_test_uptodate(folio))
+			return folio;
+		folio_put(folio);
+		return ERR_PTR(-EIO);
+	} while (--tries);
+
+	return ERR_PTR(-EINTR);
+}
+
 /* From fs/ntfs/bdev-io.c */
 int ntfs_bdev_read(struct block_device *bdev, char *data, loff_t start, size_t size);
 int ntfs_bdev_write(struct super_block *sb, void *buf, loff_t start, size_t size);
