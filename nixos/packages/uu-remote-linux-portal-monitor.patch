+/* UU_PORTAL_MONITOR=<index>: request one stream per monitor and capture only that one.
+ * KDE's RemoteDesktop portal shows no screen chooser and streams the whole workspace
+ * when multiple sources are not requested. Returns -1 when unset. */
+static int portal_monitor_index(void) {
+    const char *value = getenv("UU_PORTAL_MONITOR");
+    if (!value || !*value) return -1;
+    char *end = NULL; long index = strtol(value, &end, 10);
+    return *end || index < 0 || index > 64 ? -1 : (int)index;
+}
+/* UU_PORTAL_MONITOR_CMD: command printing "x,y", the logical position of the monitor to capture.
+ * Stream order changes with the wiring, position identifies the output on every connection.
+ * Returns 0 when unset or failed; UU_PORTAL_MONITOR is then the fallback. */
+static int portal_monitor_position(int *x, int *y) {
+    const char *command = getenv("UU_PORTAL_MONITOR_CMD");
+    gchar *output = NULL; gint status = 0; int found = 0;
+    if (!command || !*command) return 0;
+    if (g_spawn_command_line_sync(command, &output, NULL, &status, NULL) && g_spawn_check_wait_status(status, NULL))
+        found = output && sscanf(output, "%d,%d", x, y) == 2;
+    if (!found) fprintf(stderr, "UU_PORTAL_MONITOR_CMD failed; using UU_PORTAL_MONITOR\n");
+    g_free(output);
+    return found;
+}
